# Contract Review App - environment template
# Copy this file to .env at the PROJECT ROOT and fill in real values.
# NEVER commit .env. All secrets belong here as placeholders only.

# ---- HTTP ----
APP_HOST=0.0.0.0
APP_PORT=8790
# Full public URL used by the Android shell and shown in docs/status script.
# Example: http://example.com:18790/
PUBLIC_BASE_URL=

# ---- PostgreSQL ----
# An independent PostgreSQL instance is expected. The API connects with the
# least-privilege role below; RLS is enforced for every business query.
PGHOST=127.0.0.1
PGPORT=5434
PGUSER=postgres
PGDATABASE=contract_review
PGPASSWORD=
PGAPIUSER=app_api
PGAPIPASSWORD=

# ---- Auth ----
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# One-time bootstrap only; never needed by the running app.
BOOTSTRAP_PASSWORD=

# ---- LLM (optional at install time) ----
# Normally configure these in the App: admin -> LLM settings (stored in llm_config).
# The values here are only a one-time seed / fallback when that table is absent.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_MODEL_VISION=
LLM_TIMEOUT=120
LLM_MAX_TOKENS=8192

# ---- Worker behaviour ----
WORKER_POLL_SECONDS=5
WORKER_LEASE_MINUTES=120
WORKER_ALIVE_SECONDS=45
STALL_SECONDS=600

# ---- Skill renderer ----
# Leave empty to use the bundled skill at backend/skills/property-contract-review-report.
SKILL_BUILD_SCRIPT=

# ---- Runtime data (NOT bundled; ignored by git) ----
# Root directory for ALL generated/uploaded files (original PDFs, report PDFs,
# model JSON, temp files). The DB stores only paths RELATIVE to this root,
# e.g. "contracts/CT-xxx/original.pdf" and "reports/CT-xxx/v1/report.pdf".
# Moving the whole app: copy this data dir, point CONTRACT_DATA_DIR at the copy,
# and every download/render keeps working — no DB edits needed.
# Leave empty for a fresh install (uses backend/data). On this machine it points
# at the original data dir so the existing files remain valid.
CONTRACT_DATA_DIR=
# PostgreSQL data + binaries. Leave empty for a self-contained checkout that
# has pgdata/ and pg/ at the project root; set absolute paths to reuse an
# existing local cluster instead of copying ~200 MB.
CONTRACT_PGDATA=
CONTRACT_PGBIN=

# ---- Local watchdog (ops/) ----
# Absolute path to this handoff directory. Required when the launcher .cmd is
# copied to the Windows Startup folder; otherwise it is derived from the script.
CONTRACT_ROOT=
# Absolute paths or commands on PATH. pythonw.exe is preferred on Windows to
# avoid a console window; leave CONTRACT_PYW empty to derive it from CONTRACT_PY.
CONTRACT_PY=python
CONTRACT_PYW=
CONTRACT_NODE=node

# ---- Android shell build ----
ANDROID_SDK=
JAVA_HOME=
ANDROID_KEYSTORE=contract-review.keystore
ANDROID_KS_PASS=
ANDROID_KEY_PASS=
ANDROID_KEY_ALIAS=contractreview
